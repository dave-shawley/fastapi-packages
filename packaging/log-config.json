{
  "version": 1,
  "handlers": {
    "access": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "access"
    },
    "console": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "readable"
    }
  },
  "formatters": {
    "access": {
      "format": "%(asctime)s %(levelname)s %(name)s: %(client)s - \"%(method)s %(path)s HTTP/%(http_version)s\" %(status_code)s"
    },
    "readable": {
      "format": "%(asctime)s %(levelname)s %(name)s: %(message)s"
    }
  },
  "loggers": {
    "api-runner.access": {
      "handlers": ["access"],
      "propagate": false
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["console"]
  }
}
